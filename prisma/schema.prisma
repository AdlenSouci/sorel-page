generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Reflète exactement la table `article` de catalogue_sorel (import Excel SITE_WEB_SOREL).
/// Ne retirer aucun champ ici sans le retirer aussi en base : `prisma db push`
/// supprimerait la colonne et ses données.
model Article {
  id                       Int     @id @default(autoincrement())
  description              String? @db.VarChar(255)
  reference                String? @db.VarChar(100)
  conditionnement          String? @db.VarChar(100)
  dimensions               String? @db.VarChar(100)
  contenance_ml            String? @db.VarChar(100)
  process_de_cuisson       String? @db.VarChar(255)
  versage_a_chaud          String? @db.VarChar(50)
  forme                    String? @db.VarChar(100)
  avec_couvercle           String? @db.VarChar(50)
  couleur                  String? @db.VarChar(100)
  cent_pourcent_recyclable String? @db.VarChar(50)
  operculable              String? @db.VarChar(50)
  modulables               String? @db.VarChar(50)
  personnalisables         String? @db.VarChar(50)
  famille_forme            String? @db.VarChar(100)
  autre_famille            String? @db.VarChar(100)
  produit_associe_1        String? @db.VarChar(255)
  produit_associe_2        String? @db.VarChar(255)
  produit_associe_3        String? @db.VarChar(255)
  produit_associe_4        String? @db.VarChar(255)
  valeur_ajoutee_1         String? @db.Text
  valeur_ajoutee_2         String? @db.Text
  valeur_ajoutee_3         String? @db.Text
  valeur_ajoutee_4         String? @db.Text
  valeur_cial              String? @db.Text
  gamme                    String? @db.VarChar(100)
  photo                    String? @db.VarChar(500)
  photo_produit_ass1       String? @db.VarChar(500)
  photo_produit_ass2       String? @db.VarChar(500)
  photo_produit_ass3       String? @db.VarChar(500)
  photo_produit_ass4       String? @db.VarChar(500)
  photo_gamme              String? @db.VarChar(500)
  /// 33e colonne de l'Excel, sans en-tête. 3 lignes à "OUI", 222 vides.
  Column33                 String? @db.VarChar(50)

  @@index([gamme], map: "idx_article_gamme")
  @@map("article")
}
